def load_existing_proxies() -> set[str]:
    """Loads existing proxies from best_proxies.txt to prevent duplicates."""
    if not os.path.exists("best_proxies.txt"):
        return set()

    with open("best_proxies.txt", "r", encoding="utf-8") as txt_file:
        return {line.strip() for line in txt_file if line.strip()}


def save_result_files(result: dict[str, Any]) -> None:
    """Saves results to JSON and TXT files, keeping a clean and duplicate-free output."""
    with open("best_proxies.json", "w", encoding="utf-8") as json_file:
        json.dump(result, json_file, indent=4, ensure_ascii=False)

    seen: set[str] = set()
    proxies = []
    for proxy in result.get("proxies", []):
        proxy_str = f"{proxy['ip']}:{proxy['port']}"
        if proxy_str not in seen:
            proxies.append(proxy_str)
            seen.add(proxy_str)

    with open("best_proxies.txt", "w", encoding="utf-8") as txt_file:
        if proxies:
            txt_file.write("\n".join(proxies) + "\n")


def parse_proxy(line: str) -> tuple[str | None, str | None]:
    line = line.strip()
    if not line or line.startswith("#"):
        return None, None

    if "://" in line:
        cleaned = line.split("://", 1)[1]
    else:
        cleaned = line

    if ":" not in cleaned:
        return None, None

    ip, port = cleaned.rsplit(":", 1)
    return ip.strip(), port.strip()


async def test_single_proxy(session: aiohttp.ClientSession, proxy: str, proxy_type: str) -> dict[str, Any] | None:
    ip, port = parse_proxy(proxy)
    if not ip or not port:
        return None

    proxy_scheme = "https" if proxy_type == "https" else "http"
    proxy_url = f"{proxy_scheme}://{ip}:{port}"
    target_url = TEST_TARGETS.get(proxy_type, TEST_TARGETS["mixed"])
    start = time.time()

    try:
        async with session.get(
            target_url,
            proxy=proxy_url,
            timeout=aiohttp.ClientTimeout(total=15),
            headers={"User-Agent": "Mozilla/5.0 (ProxyTest/1.0)"},
        ) as response:
            elapsed = round((time.time() - start) * 1000, 1)
            if response.status != 200:
                return {"status": "fail", "reason": f"HTTP status: {response.status}", "time_ms": 0}
            return {
                "status": "success",
                "ip": ip,
                "port": int(port),
                "time_ms": elapsed,
                "proxy_str": proxy,
                "proxy_type": proxy_type,
            }
    except Exception as exc:  # pragma: no cover - network error path
        return {"status": "fail", "reason": f"Error: {exc}", "time_ms": 0}


def load_proxies(url: str, fmt: str, filter_func, proxy_type: str) -> list[str]:
    if fmt == "json":
        try:
            response = requests.get(url, timeout=15)
            response.raise_for_status()
            data = response.json()
            proxies = []
            for item in data.get("data", {}).get("list", [])[:PROXY_LIMIT]:
                if filter_func(item):
                    ip = item.get("ip")
                    port = item.get("port")
                    if ip and port:
                        proxies.append(f"{ip}:{port}")
            return proxies
        except Exception as exc:  # pragma: no cover - network error path
            print(f"Error loading JSON {url}: {exc}")
            return []

    try:
        response = requests.get(url, timeout=15)
        response.raise_for_status()
        lines = response.text.splitlines()
        proxies = []
        for line in lines:
            candidate = line.strip()
            if not candidate or candidate.startswith("#"):
                continue
            if "http://" in candidate or "https://" in candidate:
                candidate = candidate.split("://", 1)[1]
            if candidate.count(":") >= 1:
                proxies.append(candidate)
        return proxies[:PROXY_LIMIT]
    except Exception as exc:  # pragma: no cover - network error path
        print(f"Error loading TXT {url}: {exc}")
        return []


async def test_batch(session: aiohttp.ClientSession, proxies: list[str], proxy_type: str) -> list[dict[str, Any]]:
    tasks = [asyncio.create_task(test_single_proxy(session, proxy, proxy_type)) for proxy in proxies[:CONCURRENT]]
    results = await asyncio.gather(*tasks, return_exceptions=True)

    successful = []
    for item in results:
        if isinstance(item, Exception):
            continue
        if item and item.get("status") == "success":
            successful.append(item)

    successful.sort(key=lambda item: item["time_ms"])
    return successful


def main() -> None:
    print(f"🚀 Starting Proxy Tester ({datetime.now().strftime('%Y-%m-%d %H:%M:%S')})")
    print("=" * 80)

    all_results: list[dict[str, Any]] = []
    seen = set()

    for source_name, info in APIs.items():
        proxy_type = info.get("type", "http")
        proxies = load_proxies(info["url"], info["format"], info["filter"], proxy_type)
        print(f"📥 Downloading {source_name} ({len(proxies)} candidates)...")

        async def run_batch() -> list[dict[str, Any]]:
            async with aiohttp.ClientSession() as session:
                return await test_batch(session, proxies, proxy_type)

        batch_results = asyncio.run(run_batch())
        for result in batch_results:
            key = f"{result['ip']}:{result['port']}"
            if key not in seen:
                seen.add(key)
                all_results.append(result)

        print(f"  ✅ {len(batch_results)} successful from {source_name}")

    print("=" * 80)
    if all_results:
        all_results.sort(key=lambda item: item["time_ms"])
        print(f"\n🌟 Total working proxies found: {len(all_results)}")
        for result in all_results[:20]:
            print(f"   {result['ip']}:{result['port']} → {result['time_ms']}ms ({result.get('proxy_type', 'http')})")

        payload = {
            "total_proxies": len(all_results),
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "test_url": TEST_TARGETS.get("https", "https://www.google.com"),
            "proxies": all_results,
        }
        save_result_files(payload)
        print("💾 Saved to best_proxies.json")
        print("💾 Saved to best_proxies.txt")
    else:
        print("❌ No successful proxies found. Consider retrying later.")


if __name__ == "__main__":
    main()
